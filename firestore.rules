rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active() {
      return profileExists() && profile().active == true
        && ((profile().role == 'admin'
          && request.auth.token.firebase.sign_in_provider == 'google.com')
          || (profile().role == 'teacher'
            && request.auth.token.firebase.sign_in_provider == 'password'));
    }
    function admin() {
      return active() && profile().role == 'admin';
    }
    function memberOf(familyId) {
      return active() && (profile().role == 'admin' ||
        (profile().role == 'teacher' && familyId in profile().familyIds));
    }
    function validProfile(data) {
      return data.keys().hasAll(['name','email','role','active','familyIds'])
        && data.keys().hasOnly(['name','email','role','active','familyIds','username'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.email is string && data.email.size() <= 254
        && (!('username' in data) || (data.username is string && data.username.matches('^[a-z][a-z0-9._-]{2,31}$')))
        && data.role == 'teacher'
        && data.active is bool && data.familyIds is list
        && data.familyIds.size() <= 21;
    }
    function validFamily(data) {
      return data.keys().hasAll(['name','active'])
        && data.keys().hasOnly(['name','active'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.active is bool;
    }
    function validStudent(data, id) {
      return data.keys().hasAll(['studentId','name','room','familyId'])
        && data.keys().hasOnly(['studentId','name','room','familyId','active'])
        && data.studentId == id
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.room is string && data.room.size() > 0 && data.room.size() <= 30
        && data.familyId is string && data.familyId.size() > 0 && data.familyId.size() <= 30
        && (!('active' in data) || data.active is bool);
    }
    function validRound(data) {
      return data.keys().hasAll(['name','date','status'])
        && data.keys().hasOnly(['name','date','status'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.date is string && data.date.size() == 10
        && data.status in ['open','closed'];
    }
    function roundOpen(roundId) {
      return exists(/databases/$(database)/documents/inspection_rounds/$(roundId))
        && get(/databases/$(database)/documents/inspection_rounds/$(roundId)).data.status == 'open';
    }
    function studentMatches(data) {
      return exists(/databases/$(database)/documents/students/$(data.studentId))
        && get(/databases/$(database)/documents/students/$(data.studentId)).data.familyId == data.familyId
        && get(/databases/$(database)/documents/students/$(data.studentId)).data.get('active',true) == true;
    }
    // Second monthly round: only students explicitly marked 'not_checked'
    // in the PRIMARY round are eligible. This is not an attendance record.
    function primaryWasAbsent(data) {
      return exists(/databases/$(database)/documents/inspections/$(data.roundId + '__' + data.studentId))
        && get(/databases/$(database)/documents/inspections/$(data.roundId + '__' + data.studentId)).data.status == 'not_checked'
        && get(/databases/$(database)/documents/inspections/$(data.roundId + '__' + data.studentId)).data.familyId == data.familyId;
    }
    function validInspection(data) {
      return data.keys().hasAll(['roundId','studentId','familyId','status','issueTypes',
        'note','resolution','createdBy','createdAt','updatedBy','updatedAt'])
        && data.keys().hasOnly(['roundId','studentId','familyId','status','issueTypes',
          'note','resolution','createdBy','createdAt','updatedBy','updatedAt'])
        && data.roundId is string && data.roundId.size() > 0 && data.roundId.size() <= 30
        && data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 60
        && data.familyId is string && data.familyId.size() > 0 && data.familyId.size() <= 30
        && data.status in ['pass','issue','not_checked']
        && data.issueTypes is list && data.issueTypes.size() <= 8
        && data.issueTypes.hasOnly(['hair','shirt','bottom','shoes','belt','nails','accessory','other'])
        && data.note is string && data.note.size() <= 500
        && data.resolution in ['none','pending','resolved']
        && (data.status == 'issue'
          ? (data.issueTypes.size() > 0 && data.resolution in ['pending','resolved'])
          : (data.issueTypes.size() == 0 && data.resolution == 'none'))
        && data.createdBy is string && data.updatedBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validEvent(data, id) {
      return data.keys().hasAll(['inspectionId','roundId','studentId','familyId',
        'actorUid','status','resolution','issueTypes','note','createdAt'])
        && data.keys().hasOnly(['inspectionId','roundId','studentId','familyId',
          'actorUid','status','resolution','issueTypes','note','createdAt'])
        && data.inspectionId == data.roundId + '__' + data.studentId
        && data.inspectionId is string && data.roundId is string
        && data.studentId is string && data.familyId is string
        && data.actorUid == request.auth.uid
        && data.status in ['pass','issue','not_checked']
        && data.resolution in ['none','pending','resolved']
        && data.issueTypes is list && data.issueTypes.size() <= 8
        && data.issueTypes.hasOnly(['hair','shirt','bottom','shoes','belt','nails','accessory','other'])
        && data.note is string && data.note.size() <= 500
        && data.createdAt == request.time;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      // Only the bootstrap admin may create teacher metadata. No second admin via UI.
      allow create: if admin() && validProfile(request.resource.data);
      allow update: if admin() && resource.data.role == 'teacher'
        && validProfile(request.resource.data);
      allow delete: if admin() && resource.data.role == 'teacher';
    }

    match /families/{familyId} {
      allow read: if memberOf(familyId);
      allow create, update: if admin() && validFamily(request.resource.data);
      allow delete: if admin();
    }

    match /students/{studentId} {
      allow read: if memberOf(resource.data.familyId);
      allow create, update: if admin() && validStudent(request.resource.data, studentId);
      allow delete: if admin();
    }

    match /inspection_rounds/{roundId} {
      allow read: if active();
      allow create, update: if admin() && validRound(request.resource.data);
      allow delete: if admin();
    }

    match /inspections/{inspectionId} {
      allow read: if memberOf(resource.data.familyId);
      allow create: if validInspection(request.resource.data)
        && inspectionId == request.resource.data.roundId + '__' + request.resource.data.studentId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && memberOf(request.resource.data.familyId)
        && (admin() || (roundOpen(request.resource.data.roundId)
          && studentMatches(request.resource.data)));
      allow update: if validInspection(request.resource.data)
        && request.resource.data.roundId == resource.data.roundId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','issueTypes','note','resolution','updatedBy','updatedAt'])
        && memberOf(resource.data.familyId)
        && (admin() || (roundOpen(resource.data.roundId)
          && studentMatches(resource.data)));
      allow delete: if admin();
    }

    match /inspection_events/{eventId} {
      allow read: if memberOf(resource.data.familyId);
      // Append-only operational change log. For tamper-proof logs, use trusted backend later.
      allow create: if validEvent(request.resource.data, eventId)
        && memberOf(request.resource.data.familyId)
        && (admin() || roundOpen(request.resource.data.roundId))
        && existsAfter(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId))
        && getAfter(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId)).data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId)).data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId)).data.roundId == request.resource.data.roundId
        && getAfter(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId)).data.studentId == request.resource.data.studentId
        && getAfter(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId)).data.familyId == request.resource.data.familyId
        && getAfter(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId)).data.status == request.resource.data.status
        && getAfter(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId)).data.resolution == request.resource.data.resolution
        && getAfter(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId)).data.issueTypes == request.resource.data.issueTypes
        && getAfter(/databases/$(database)/documents/inspections/$(request.resource.data.inspectionId)).data.note == request.resource.data.note;
      allow update, delete: if false;
    }

    // Independent second-pass records preserve the monthly primary results.
    match /inspection_round2/{inspectionId} {
      allow read: if memberOf(resource.data.familyId);
      allow create: if validInspection(request.resource.data)
        && inspectionId == request.resource.data.roundId + '__' + request.resource.data.studentId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && memberOf(request.resource.data.familyId)
        && roundOpen(request.resource.data.roundId)
        && studentMatches(request.resource.data)
        && primaryWasAbsent(request.resource.data);
      allow update: if validInspection(request.resource.data)
        && request.resource.data.roundId == resource.data.roundId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','issueTypes','note','resolution','updatedBy','updatedAt'])
        && memberOf(resource.data.familyId)
        && roundOpen(resource.data.roundId)
        && studentMatches(resource.data)
        && primaryWasAbsent(resource.data);
      allow delete: if false;
    }


    match /inspection_round2_events/{eventId} {
      allow read: if memberOf(resource.data.familyId);
      // Append-only operational change log. For tamper-proof logs, use trusted backend later.
      allow create: if validEvent(request.resource.data, eventId)
        && memberOf(request.resource.data.familyId)
        && roundOpen(request.resource.data.roundId)
        && primaryWasAbsent(request.resource.data)
        && existsAfter(/databases/$(database)/documents/inspection_round2/$(request.resource.data.inspectionId))
        && getAfter(/databases/$(database)/documents/inspection_round2/$(request.resource.data.inspectionId)).data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/inspection_round2/$(request.resource.data.inspectionId)).data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/inspection_round2/$(request.resource.data.inspectionId)).data.roundId == request.resource.data.roundId
        && getAfter(/databases/$(database)/documents/inspection_round2/$(request.resource.data.inspectionId)).data.studentId == request.resource.data.studentId
        && getAfter(/databases/$(database)/documents/inspection_round2/$(request.resource.data.inspectionId)).data.familyId == request.resource.data.familyId
        && getAfter(/databases/$(database)/documents/inspection_round2/$(request.resource.data.inspectionId)).data.status == request.resource.data.status
        && getAfter(/databases/$(database)/documents/inspection_round2/$(request.resource.data.inspectionId)).data.resolution == request.resource.data.resolution
        && getAfter(/databases/$(database)/documents/inspection_round2/$(request.resource.data.inspectionId)).data.issueTypes == request.resource.data.issueTypes
        && getAfter(/databases/$(database)/documents/inspection_round2/$(request.resource.data.inspectionId)).data.note == request.resource.data.note;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}